{
  "name": "@vayada/backend-migration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Target schema SQL migration runner and local parity harness for the TypeScript backend.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "target:migrate": "tsx src/cli/migrate.ts",
    "target:rebuild": "tsx src/cli/rebuild.ts",
    "target:source:extract": "tsx src/cli/sourceExtract.ts",
    "target:identity:migrate": "tsx src/cli/productionIdentityMigration.ts",
    "target:catalog:migrate": "tsx src/cli/productionCatalogMigration.ts",
    "target:media:migrate": "tsx src/cli/productionMediaMigration.ts",
    "target:booking:migrate": "tsx src/cli/productionBookingMigration.ts",
    "target:pms:migrate": "tsx src/cli/productionPmsMigration.ts",
    "target:marketplace:migrate": "tsx src/cli/productionMarketplaceMigration.ts",
    "target:finance:migrate": "tsx src/cli/productionFinanceMigration.ts",
    "target:parity": "tsx src/cli/parity.ts",
    "target:rehearse:staging": "tsx src/cli/cutover.ts rehearse-staging",
    "target:migration-status": "tsx src/cli/cutover.ts status",
    "target:cutover:dry-run": "tsx src/cli/cutover.ts dry-run",
    "target:cutover": "tsx src/cli/cutover.ts cutover",
    "target:cutover:abort": "tsx src/cli/cutover.ts abort",
    "target:c1-rehearsal:checks": "tsx src/cli/c1RehearsalChecks.ts",
    "target:manual-booking:readiness": "tsx src/cli/manualBookingReadiness.ts",
    "target:platform-identity:bootstrap": "tsx src/cli/platformIdentityBootstrap.ts",
    "target:workos:backfill": "tsx src/cli/workosBackfill.ts",
    "target:workos:audit": "tsx src/cli/workosLinkAudit.ts",
    "target:next-smoke:backfill": "tsx src/cli/nextSmokeBackfill.ts",
    "target:booking-public-bookability:backfill": "tsx src/cli/bookingPublicBookabilityBackfill.ts",
    "target:fixtures:smoke": "tsx src/cli/smoke.ts",
    "target:migrate:dist": "node dist/cli/migrate.js",
    "target:source:extract:dist": "node dist/cli/sourceExtract.js",
    "target:identity:migrate:dist": "node dist/cli/productionIdentityMigration.js",
    "target:catalog:migrate:dist": "node dist/cli/productionCatalogMigration.js",
    "target:media:migrate:dist": "node dist/cli/productionMediaMigration.js",
    "target:booking:migrate:dist": "node dist/cli/productionBookingMigration.js",
    "target:pms:migrate:dist": "node dist/cli/productionPmsMigration.js",
    "target:marketplace:migrate:dist": "node dist/cli/productionMarketplaceMigration.js",
    "target:finance:migrate:dist": "node dist/cli/productionFinanceMigration.js",
    "target:parity:dist": "node dist/cli/parity.js",
    "target:rehearse:staging:dist": "node dist/cli/cutover.js rehearse-staging",
    "target:migration-status:dist": "node dist/cli/cutover.js status",
    "target:cutover:dry-run:dist": "node dist/cli/cutover.js dry-run",
    "target:cutover:dist": "node dist/cli/cutover.js cutover",
    "target:cutover:abort:dist": "node dist/cli/cutover.js abort",
    "target:c1-rehearsal:checks:dist": "node dist/cli/c1RehearsalChecks.js",
    "target:manual-booking:readiness:dist": "node dist/cli/manualBookingReadiness.js",
    "target:platform-identity:bootstrap:dist": "node dist/cli/platformIdentityBootstrap.js",
    "target:workos:backfill:dist": "node dist/cli/workosBackfill.js",
    "target:workos:audit:dist": "node dist/cli/workosLinkAudit.js",
    "target:next-smoke:backfill:dist": "node dist/cli/nextSmokeBackfill.js",
    "target:booking-public-bookability:backfill:dist": "node dist/cli/bookingPublicBookabilityBackfill.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "@vayada/domain-marketplace": "*",
    "@vayada/locale-constants": "*",
    "@workos-inc/node": "^10.2.0",
    "pg": "^8.16.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.15"
  }
}

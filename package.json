{
  "name": "vayada",
  "version": "0.0.0",
  "private": true,
  "description": "Vayada product application monorepo",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace vayada-api run dev",
    "dev:affiliate-dashboard": "npm --workspace vayada-affiliate-dashboard run dev",
    "dev:booking-admin": "npm --workspace vayada-booking-engine-frontend-admin run dev",
    "dev:booking-web": "npm --workspace vayada-booking-engine-frontend run dev",
    "dev:landing": "npm --workspace vayada-landing run dev",
    "dev:vayada-admin": "npm --workspace vayada-admin run dev",
    "dev:marketplace-web": "npm --workspace vayada-creator-marketplace run dev",
    "dev:portless": "./scripts/dev-portless.sh",
    "dev:workos-local": "./scripts/dev-workos-local.sh",
    "dev:pms-web": "npm --workspace vayada-pms-frontend run dev",
    "seed:test-data": "./scripts/seed_test_data.sh",
    "build": "npm --workspaces --if-present run build",
    "lint": "npm --workspaces --if-present run lint",
    "pretypecheck": "npm run check:architecture-boundaries",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture-boundaries": "node scripts/check-architecture-boundaries.mjs",
    "test:architecture-boundaries": "node --test scripts/check-architecture-boundaries.test.mjs",
    "test:workos-local-config": "bash scripts/dev-workos-local-config.test.sh",
    "lint:python": "ruff check .",
    "format:python": "ruff format .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:landing": "playwright test --project=landing-chromium",
    "e2e:booking-web": "playwright test --project=booking-web-chromium",
    "e2e:affiliate-dashboard": "playwright test --project=affiliate-dashboard-chromium",
    "e2e:booking-admin": "playwright test --project=booking-admin-chromium",
    "e2e:marketplace-web": "playwright test --project=marketplace-web-chromium",
    "e2e:pms-web": "playwright test --project=pms-web-chromium",
    "e2e:vayada-admin": "playwright test --project=vayada-admin-chromium",
    "e2e:first-party-auth": "playwright test --project=first-party-auth-chromium",
    "e2e:first-party-auth:live": "playwright test --project=first-party-auth-live-chromium",
    "e2e:booking-public-canary": "playwright test --project=booking-public-canary-chromium",
    "e2e:next-stack-smoke": "playwright test --project=next-stack-smoke-chromium",
    "e2e:report": "playwright show-report",
    "build:api": "npm --workspace vayada-api run build",
    "build:affiliate-dashboard": "npm --workspace vayada-affiliate-dashboard run build",
    "build:booking-admin": "npm --workspace vayada-booking-engine-frontend-admin run build",
    "build:booking-web": "npm --workspace vayada-booking-engine-frontend run build",
    "build:landing": "npm --workspace vayada-landing run build",
    "build:vayada-admin": "npm --workspace vayada-admin run build",
    "build:marketplace-web": "npm --workspace vayada-creator-marketplace run build",
    "build:pms-web": "npm --workspace vayada-pms-frontend run build",
    "lint:affiliate-dashboard": "npm --workspace vayada-affiliate-dashboard run lint",
    "lint:booking-admin": "npm --workspace vayada-booking-engine-frontend-admin run lint",
    "lint:booking-web": "npm --workspace vayada-booking-engine-frontend run lint",
    "lint:landing": "npm --workspace vayada-landing run lint",
    "lint:vayada-admin": "npm --workspace vayada-admin run lint",
    "lint:marketplace-web": "npm --workspace vayada-creator-marketplace run lint",
    "lint:pms-web": "npm --workspace vayada-pms-frontend run lint",
    "test:api": "npm --workspace vayada-api run test",
    "typecheck:api": "npm --workspace vayada-api run typecheck",
    "target:migrate": "npm --workspace @vayada/backend-migration run target:migrate --",
    "target:rebuild": "npm --workspace @vayada/backend-migration run target:rebuild --",
    "target:identity:migrate": "npm --workspace @vayada/backend-migration run target:identity:migrate --",
    "target:catalog:migrate": "npm --workspace @vayada/backend-migration run target:catalog:migrate --",
    "target:booking:migrate": "npm --workspace @vayada/backend-migration run target:booking:migrate --",
    "target:pms:migrate": "npm --workspace @vayada/backend-migration run target:pms:migrate --",
    "target:marketplace:migrate": "npm --workspace @vayada/backend-migration run target:marketplace:migrate --",
    "target:parity": "npm --workspace @vayada/backend-migration run target:parity --",
    "prepare": "husky"
  },
  "overrides": {
    "postcss": "$postcss",
    "serialize-javascript": "$serialize-javascript"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,mdx,yml,yaml,css}": [
      "prettier --write"
    ],
    "apps/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored"
    ],
    "*.py": [
      "ruff check --fix --exit-zero",
      "ruff format"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.10",
    "prettier": "^3.5.3",
    "serialize-javascript": "^7.0.5"
  }
}

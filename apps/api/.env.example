# apps/api local environment contract
#
# TARGET_DATABASE_URL is required when apps/api starts. Other values are
# optional unless the related source/cutover flag is enabled.

HOST=0.0.0.0
PORT=8003

# WorkOS first-party browser session transport
#
# `dev-workos-local.sh` derives these exact origins for canonical portless,
# review-port, and worktree runs. Production values are platform-owned. The
# launcher enables all five migrated frontend gateways. Override this
# comma-separated list only for deliberate compatibility testing.
# AUTH_PLATFORM_ADMIN_ORIGIN=https://admin.localhost
# AUTH_MARKETPLACE_WEB_ORIGIN=https://marketplace.localhost
# AUTH_BOOKING_ADMIN_ORIGIN=https://admin.booking.localhost
# AUTH_PMS_WEB_ORIGIN=https://pms.localhost
# AUTH_AFFILIATE_DASHBOARD_ORIGIN=https://affiliate.localhost
# AUTH_COMPATIBILITY_CALLBACK_ORIGIN=https://api.localhost
# AUTH_FIRST_PARTY_SURFACES=
# AUTH_ALLOWED_ORIGINS=https://api.localhost,https://admin.localhost,https://admin.booking.localhost,https://booking.localhost,https://pms.localhost,https://marketplace.localhost,https://affiliate.localhost,https://landing.localhost
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN is ignored for active first-party cookies. Keep the old
# value only during migration so the API can expire legacy Domain cookies, then
# unset it after the cleanup window.

# Runtime guard
#
# Local development keeps the legacy-compatible DB defaults unless a source flag
# is set explicitly. Old Python service URL envs are retired and fail boot if
# present:
# BOOKING_PUBLIC_API_URL, PMS_API_URL, PMS_PUBLIC_API_URL.
#
# The next-stack production image bakes API_RUNTIME=next at build time, so it
# also fails boot if any legacy product runtime DB env is present:
# BOOKING_DATABASE_URL, BOOKING_RESERVATIONS_READ_DATABASE_URL,
# API_RUNTIME=next
# TARGET_DATABASE_URL=postgresql://...
# Marketplace discovery, collaboration, trips, and profile status always use
# TARGET_DATABASE_URL and are mounted whenever apps/api starts.
# PUBLIC_HOTEL_PROFILE_SOURCE=target
# BOOKING_DOMAIN_RESOLUTION_SOURCE=target
# PUBLIC_BOOKABILITY_SOURCE=target
# BOOKING_SETTINGS_SOURCE=target
# BOOKING_RESERVATIONS_SOURCE=target
# PMS_OPERATIONS_SOURCE=target
# FINANCE_SOURCE=target
# BOOKING_CHECKOUT_COMMAND_SOURCE=target
#
# For next-stack surfaces that are not available yet, set their source
# explicitly to disabled instead of relying on the local disabled default.
# PMS_OPERATIONS_SOURCE=disabled

# Fixed Plan subscriptions (VAY-1120)
#
# Finance and Booking checkout must both use the target database. Stripe Checkout
# activates Fixed only after an `invoice.paid` webhook; recurring failures keep
# the plan active while Stripe retries. The fixed Price is created once with a
# 30-day interval unless a pre-provisioned Price ID is supplied.
# FINANCE_SOURCE=target
# BOOKING_CHECKOUT_COMMAND_SOURCE=target
# STRIPE_SECRET_KEY=sk_...
# STRIPE_FIXED_PLAN_PRICE_ID=price_... # optional
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_WEBHOOK_INTAKE_MODE=mutating
# BOOKING_ADMIN_BASE_URL=https://admin.booking.localhost
# RESEND_API_KEY=re_... # required for target Booking checkout in production
# BOOKING_EMAIL_FROM=Vayada Bookings <bookings@example.com>

# Ask Intelligence
# Fixture evidence stays the local/test default. Set target only when
# TARGET_DATABASE_URL points at the migrated target database.
# Fixture model mode is also the local/test default. Set OpenAI only for an
# environment that has the provider secret and model configured.
# ASK_INTELLIGENCE_PROVIDER=fixture
# ASK_INTELLIGENCE_PROVIDER=openai
# ASK_INTELLIGENCE_MODEL=gpt-5.5
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=org_...
# OPENAI_PROJECT=proj_...
#
# Roll back OpenAI mode by setting ASK_INTELLIGENCE_PROVIDER=fixture or removing
# ASK_INTELLIGENCE_PROVIDER, ASK_INTELLIGENCE_MODEL, and OPENAI_* values.
# Deployment values are owned outside this repo by the platform task definition
# for next-target-backend; keep OPENAI_API_KEY in AWS SSM/Secrets Manager, not in
# GitHub Actions logs or committed env files.
# ASK_INTELLIGENCE_EVIDENCE_SOURCE=fixture
# ASK_INTELLIGENCE_EVIDENCE_SOURCE=target

# Platform media serving (VAY-821)
# Complete auth plus TARGET_DATABASE_URL require the complete group below because
# creator profile photos are mandatory. Production values are provisioned in the
# ECS task definition, not committed here.
#
# Required as a complete set when platform media serving is activated:
# - PLATFORM_MEDIA_BUCKET: private platform media bucket for this environment.
# - PLATFORM_MEDIA_CDN_BASE_URL: public CDN HTTPS origin, no path/query.
# - PLATFORM_MEDIA_CDN_ORIGIN_HOST: private bucket origin host used by the CDN.
#
# Public URL shape:
#   {PLATFORM_MEDIA_CDN_BASE_URL}/{PLATFORM_MEDIA_PUBLIC_PATH_PREFIX}/{mediaId}/{variant}/{version}.{ext}
# Public URLs are immutable and cacheable; replacing media must mint a new media
# object or version URL instead of overwriting the old URL.
#
# Private media is never served from the public CDN path. Authorized downloads
# use short-lived signed object URLs or a platform endpoint that signs with the
# same TTL limits.
# PLATFORM_MEDIA_BUCKET=vayada-media-development
# PLATFORM_MEDIA_CDN_BASE_URL=https://cdn.dev.vayada.example
# PLATFORM_MEDIA_CDN_ORIGIN_HOST=vayada-media-development.s3.us-east-1.amazonaws.com
# PLATFORM_MEDIA_PUBLIC_PATH_PREFIX=media
# PLATFORM_MEDIA_PUBLIC_CACHE_CONTROL=public, max-age=31536000, immutable
# PLATFORM_MEDIA_PRIVATE_DOWNLOAD_TTL_SECONDS=300
#
# PLATFORM_MEDIA_PRIVATE_DOWNLOAD_MAX_TTL_SECONDS=900
# PLATFORM_MEDIA_CLEANUP_ENABLED=true
# PLATFORM_MEDIA_CLEANUP_INTERVAL_MS=900000
# PROPERTY_SETUP_DRAFT_RETENTION_ENABLED=true
# PROPERTY_SETUP_DRAFT_RETENTION_INTERVAL_MS=3600000
# PROPERTY_SETUP_DRAFT_RETENTION_BATCH_SIZE=100
# PMS_INVENTORY_PUBLIC_OFFER_RETRY_ENABLED=true
# PMS_INVENTORY_PUBLIC_OFFER_RETRY_INTERVAL_MS=30000
# AWS credentials are resolved through the normal SDK chain (the ECS task role
# in production); do not add long-lived access keys here.

# Creator platform connections
#
# Each Connect action becomes available when that provider's complete config
# group is present. OAuth grants are stored in AWS Secrets Manager; PostgreSQL
# stores only the secret reference. `memory` is available for local adapter
# testing and is rejected when NODE_ENV=production.
# CREATOR_PLATFORM_CALLBACK_BASE_URL=https://api.example.com
# CREATOR_PLATFORM_WEB_RETURN_URL=https://marketplace.example.com/profile/complete
# CREATOR_PLATFORM_CREDENTIAL_VAULT=aws-secrets-manager
# CREATOR_PLATFORM_SECRET_PREFIX=vayada/production/creator-platforms
# AWS_REGION=eu-central-1
#
# Instagram Login (professional Creator or Business accounts)
# INSTAGRAM_CLIENT_ID=...
# INSTAGRAM_CLIENT_SECRET=...
# INSTAGRAM_API_VERSION=v25.0
#
# Facebook Login (managed Pages only)
# FACEBOOK_CLIENT_ID=...
# FACEBOOK_CLIENT_SECRET=...
# FACEBOOK_GRAPH_API_VERSION=v25.0
#
# TikTok Login Kit + Display API
# TIKTOK_CLIENT_KEY=...
# TIKTOK_CLIENT_SECRET=...
#
# Google OAuth + YouTube Data/Analytics APIs
# GOOGLE_YOUTUBE_CLIENT_ID=...
# GOOGLE_YOUTUBE_CLIENT_SECRET=...

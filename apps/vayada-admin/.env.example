# apps/api — target admin data API.
#   portless default:  https://api.localhost
#   plain-port dev:    http://localhost:8003
# NEXT_PUBLIC_API_URL=

# Legacy rollout setting retained for deployment compatibility. First-party
# browser auth uses the relative /auth gateway below.
#   portless default:  https://api.localhost
#   plain-port dev:    http://localhost:8003
# NEXT_PUBLIC_AUTH_API_URL=

# Server-only first-party /auth gateway settings. Platform administration
# clients remain on NEXT_PUBLIC_API_URL / NEXT_PUBLIC_VAYADA_API_URL.
#   portless public origin: https://admin.localhost
#   plain-port public origin: http://localhost:3001
# AUTH_PUBLIC_ORIGIN=
# AUTH_GATEWAY_UPSTREAM_ORIGIN=http://127.0.0.1:8003

# TypeScript Vayada API used by shared Marketplace contracts.
# Usually the same value as NEXT_PUBLIC_AUTH_API_URL.
# NEXT_PUBLIC_VAYADA_API_URL=

# Rollback switch for VAY-748. Set to "false" to return /login to legacy password auth.
# NEXT_PUBLIC_AUTHKIT_LOGIN_ENABLED=true

# Temporary compatibility JWT bridge for browser calls to unmigrated legacy APIs.
# Omitted/false keeps the bridge disabled; set true only for an intentional
# legacy compatibility rollout.
# NEXT_PUBLIC_AUTHKIT_COMPATIBILITY_TOKEN_ENABLED=true

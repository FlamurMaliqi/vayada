# Server-side rewrite destination for the TypeScript public Booking Web API.
#   portless default:  https://api.localhost
#   plain-port dev:    http://localhost:8003
# BOOKING_WEB_API_URL=
# NEXT_PUBLIC_BOOKING_WEB_API_URL= # backwards-compatible build-time fallback

# Server-side rewrite destination for remaining Booking API reads.
#   portless default:  https://api.booking.localhost
#   plain-port dev:    http://localhost:8001
#   mock-data mode: leave NEXT_PUBLIC_API_URL empty
# BOOKING_API_URL=
# NEXT_PUBLIC_API_URL= # backwards-compatible build-time fallback

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_HOTEL_SLUG=hotel-alpenrose

# Browser key for Google Maps and nearby place cards; restrict to allowed referrers/APIs.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

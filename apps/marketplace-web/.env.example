# marketplace-api
# Code defaults to portless URL; set only to override.
#   portless default:  https://api.marketplace.localhost
#   plain-port dev:    http://localhost:8000
#   production:        https://api.vayada.com
# NEXT_PUBLIC_API_URL=

# TypeScript Vayada API used by auth and migrated Marketplace contracts.
# This must never point at the legacy Python marketplace-api above.
#   portless default:  https://api.localhost
#   plain-port dev:    http://localhost:8003
#   production:        https://next-api.vayada.com
# NEXT_PUBLIC_AUTH_API_URL=

# Server-only first-party /auth gateway settings. Once the gateway lands,
# browser auth uses /auth; NEXT_PUBLIC_AUTH_API_URL stays on apps/api.
#   portless public origin: https://marketplace.localhost
#   plain-port public origin: http://localhost:3000
# AUTH_PUBLIC_ORIGIN=
# AUTH_GATEWAY_UPSTREAM_ORIGIN=http://127.0.0.1:8003

# TypeScript Vayada API used by migrated Marketplace contracts.
# Usually the same value as NEXT_PUBLIC_AUTH_API_URL, but kept explicit so
# shared Marketplace clients do not inherit the legacy Python API URL.
# NEXT_PUBLIC_VAYADA_API_URL=

# apps/api platform media upload-session API
# Code defaults to portless apps/api URL; set only to override.
#   portless default:  https://api.localhost
#   plain-port dev:    http://localhost:8003
#   production:        https://api.vayada.com
# NEXT_PUBLIC_PLATFORM_MEDIA_API_URL=

# Google Places suggestions in the shared hotel address step.
# Enable Maps JavaScript API + Places API (New), then restrict this public key
# to the frontend's HTTP referrers in Google Cloud.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# PMS frontend (deep-link target for the product chooser → PMS login)
# Default in code: https://pms.vayada.com (prod).
#   portless dev:      https://pms.localhost
#   plain-port dev:    http://localhost:3004
NEXT_PUBLIC_PMS_URL=https://pms.vayada.com

# Booking-admin frontend (sidebar app-switcher / handoff target)
# Default in code: https://admin.booking.vayada.com (prod).
#   portless dev:      https://admin.booking.localhost
#   plain-port dev:    http://localhost:3003
NEXT_PUBLIC_BOOKING_ADMIN_URL=https://admin.booking.vayada.com

# Marketplace frontend origin (trusted WorkOS return_to target)
# Default in code: https://app.vayada.com (prod).
#   next env:          https://next-marketplace.vayada.com
#   portless dev:      https://marketplace.localhost
#   plain-port dev:    http://localhost:3000
# NEXT_PUBLIC_MARKETPLACE_URL=

# Marketing/landing site (out-links from this app)
# Default in code: https://vayada.com (prod).
#   portless dev:      https://landing.localhost
#   plain-port dev:    http://localhost:3006
NEXT_PUBLIC_MARKETING_URL=https://vayada.com

# Server-only rollout switch for the replacement adaptive hotel setup shell.
# Leave disabled until the canonical property setup route has production
# owner-state providers and is mounted. This value must not use NEXT_PUBLIC_.
HOTEL_SETUP_ADAPTIVE_SHELL_ENABLED=false

# Development/E2E-only opt-in. When enabled, add `_adaptive=1` to /setup.
# It is intentionally ignored in production.
HOTEL_SETUP_ADAPTIVE_SHELL_PREVIEW_ENABLED=false

# Node Environment
# Set to 'development' for local development, 'production' for production builds
NODE_ENV=development

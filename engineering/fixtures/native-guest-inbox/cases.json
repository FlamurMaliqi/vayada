      "entitlement": "pms:property-management",
      "resource": "pms_property"
    },
    {
      "operation": "triage-follow-up-assign-note-start-reply",
      "permissions": ["pms.inbox.read", "pms.inbox.reply"],
      "entitlement": "pms:property-management",
      "resource": "pms_property"
    },
    {
      "operation": "list-preview-quick-reply",

    {
      "operation": "prepare-finalize-inbox-attachment",
      "permissions": ["pms.inbox.reply"],
      "entitlement": "pms:property-management",
      "resource": "pms_property"
    },
    {
      "operation": "return-guest-contact",
      "permissions": ["pms.guest_contact.read"]
    }
  ],
  "cases": [
    {
      "id": "list-attention-unread-threads",
      "operation": "GET /api/pms/properties/prop_1/messaging/threads",
      "query": {
        "attentionState": "needs_attention",
        "unread": true,
        "channel": "ota",
        "search": "LEE",
        "limit": 25
      },
      "context": {
        "authenticated": true,
        "permissions": ["pms.inbox.read"],
        "entitlement": "active",
        "propertyAccess": "prop_1"
      },
      "expected": {
        "status": 200,
        "sort": ["activityAt:desc", "id:desc"],
        "searchIsCaseInsensitive": true,
        "searchIsRedactedFromLogs": true,
        "cursorContainsFilterHashOnly": true,
        "nextCursorIsOpaque": true,
        "itemsMatchProperty": "prop_1"
      }
    },
    {
      "id": "reject-filter-mismatched-cursor",
      "operation": "GET /api/pms/properties/prop_1/messaging/threads",
      "query": {
        "attentionState": "done",
        "cursor": "cursor_for_attention_filter"
      },
      "expected": { "status": 400, "code": "invalid_cursor" }
    },
    {
      "id": "deny-unauthenticated-without-existence-leak",
      "operation": "GET /api/pms/properties/prop_1/messaging/threads/thread_secret",
      "context": { "authenticated": false },
      "expected": {
        "status": 401,
        "code": "unauthenticated",
        "threadLookupPerformed": false
      }
    },
    {
      "id": "deny-missing-read-permission",
      "operation": "GET /api/pms/properties/prop_1/messaging/threads/thread_1",
      "context": {
        "authenticated": true,
        "permissions": [],
        "entitlement": "active",
        "propertyAccess": "prop_1"
      },
      "expected": { "status": 403, "code": "missing_permission" }
    },
    {
      "id": "deny-start-direct-email-without-reply-permission",
      "operation": "POST /api/pms/properties/prop_1/messaging/threads",
      "headers": { "Idempotency-Key": "start-email-denied" },
      "input": { "bookingId": "booking_secret" },
      "context": {
        "authenticated": true,
        "permissions": ["pms.inbox.read"],
        "entitlement": "active",
        "propertyAccess": "prop_1"
      },
      "expected": {
        "status": 403,
        "code": "missing_permission",
        "bookingLookupPerformed": false
      }
    },
    {
      "id": "deny-missing-entitlement",
      "operation": "GET /api/pms/properties/prop_1/messaging/unread-count",
      "context": {
        "authenticated": true,
        "permissions": ["pms.inbox.read"],
        "entitlement": "missing",
        "propertyAccess": "prop_1"
      },
      "expected": { "status": 403, "code": "missing_entitlement" }
    },
    {
      "id": "deny-inactive-entitlement",
      "operation": "GET /api/pms/properties/prop_1/messaging/unread-count",
      "context": {
        "authenticated": true,
        "permissions": ["pms.inbox.read"],
        "entitlement": "suspended",
        "propertyAccess": "prop_1"
      },
      "expected": { "status": 403, "code": "inactive_entitlement" }
    },
    {
      "id": "deny-cross-property-access",
      "operation": "GET /api/pms/properties/prop_2/messaging/threads/thread_1",
      "context": {
        "authenticated": true,
        "permissions": ["pms.inbox.read"],
        "entitlement": "active",
        "propertyAccess": "prop_1"
      },
      "expected": {
        "status": 403,
        "code": "missing_resource_access",
        "threadLookupPerformed": false
      }
    },

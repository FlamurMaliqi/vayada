{
  "version": 1,
  "operation": "hotel_setup.tracks.update",
  "baseRequest": {
    "organizationId": "11111111-1111-4111-8111-111111111111",
    "selectedTracks": ["hotel_operations"],
    "expectedRevision": 0
  },
  "cases": [
    {
      "id": "exact_retry",
      "idempotencyKey": "setup-exact-retry",
      "change": "request_audit_metadata",
      "expected": "exact_stored_result"
    },
    {
      "id": "changed_payload",
      "idempotencyKey": "setup-changed-payload",
      "change": "selected_tracks",
      "selectedTracks": ["hotel_operations", "creator_marketplace"],
      "expected": "idempotency_key_conflict"
    },
    {
      "id": "changed_revision",
      "idempotencyKey": "setup-changed-revision",
      "change": "expected_revision",
      "expectedRevision": 1,
      "expected": "idempotency_key_conflict"
    },
    {
      "id": "concurrent_stale_write",
      "idempotencyKey": "setup-concurrent-stale",
      "change": "concurrent_command",
      "expected": "track_revision_conflict"
    },
    {
      "id": "injected_audit_rollback",
      "idempotencyKey": "setup-audit-rollback",
      "change": "audit_insert_failure",
      "expected": "transaction_rollback"
    }
  ],
  "authorizationCases": [
    {
      "id": "missing_auth",
      "given": {
        "authentication": "missing",
        "permissions": ["hotel_catalog.products.manage"],
        "organizationKind": "hotel_group"
      },
      "expected": {
        "status": 401,
        "errorCode": "unauthenticated",
        "category": "authentication",
        "message": "A valid access token is required.",
        "attemptRepositoryCalls": 0
      }
    },
    {
      "id": "invalid_bearer",
      "given": {
        "authentication": "invalid",
        "permissions": ["hotel_catalog.products.manage"],
        "organizationKind": "hotel_group"
      },
      "expected": {
        "status": 401,
        "errorCode": "unauthenticated",
        "category": "authentication",
        "message": "A valid access token is required.",
        "attemptRepositoryCalls": 0
      }
    },
    {
      "id": "missing_permission",
      "given": {
        "authentication": "valid",
        "permissions": [],
        "organizationKind": "hotel_group"
      },
      "expected": {
        "status": 403,
        "errorCode": "missing_permission",
        "category": "authorization",
        "message": "Missing required hotel product management permission.",
        "attemptRepositoryCalls": 0
      }
    },
    {
      "id": "wrong_organization_scope",
      "given": {
        "authentication": "valid",
        "permissions": ["hotel_catalog.products.manage"],
        "organizationKind": "creator_workspace"
      },
      "expected": {
        "status": 403,
        "errorCode": "invalid_organization_scope",
        "category": "authorization",
        "message": "Hotel setup track changes require a hotel-group organization.",
        "attemptRepositoryCalls": 0
      }
    },
    {
      "id": "permission_revoked_before_exact_retry",
      "given": {
        "authentication": "valid",
        "permissions": ["hotel_catalog.products.manage"],
        "organizationKind": "hotel_group",
        "revokePermissionBeforeExactRetry": true
      },
      "expected": {
        "status": 403,
        "errorCode": "missing_permission",
        "category": "authorization",
        "message": "Missing required hotel product management permission.",
        "attemptRepositoryCalls": 0
      }
    },
    {
      "id": "allowed",
      "given": {
        "authentication": "valid",
        "permissions": ["hotel_catalog.products.manage"],
        "organizationKind": "hotel_group"
      },
      "expected": {
        "status": 200,
        "attemptRepositoryCalls": 1
      }
    }
  ],
  "externalOperation": {
    "operation": "booking.publication.request",
    "baseRequest": {
      "organizationId": "11111111-1111-4111-8111-111111111111",
      "propertyId": "22222222-2222-4222-8222-222222222222",
      "expectedActiveContentRevisionId": null,
      "sourceManifestHash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "readinessHash": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    }
  },
  "externalOperationCases": [
    {
      "id": "accepted_is_pending",
      "change": "none",
      "expected": "stable_operation_id_and_pending_status"
    },
    {
      "id": "exact_retry",
      "change": "request_audit_metadata",
      "expected": "same_operation_id_without_duplicate_outbox"
    },
    {
      "id": "changed_expected_active_revision",
      "change": "expected_active_content_revision_id",
      "expected": "idempotency_key_conflict"
    },
    {
      "id": "stale_active_revision",
      "change": "active_pointer_advanced",
      "expected": "active_content_revision_conflict"
    },
    {
      "id": "concurrent_open_operation",
      "change": "different_key_same_property_while_pending",
      "expected": "publication_in_progress"
    },
    {
      "id": "injected_outbox_rollback",
      "change": "outbox_insert_failure",
      "expected": "attempt_idempotency_event_audit_and_outbox_rollback"
    },
    {
      "id": "cross_tenant_status_read",
      "change": "authorized_tenant",
      "expected": "not_found"
    },
    {
      "id": "unknown_is_not_success",
      "change": "external_outcome_unresolved",
      "expected": "unknown"
    },
    {
      "id": "confirmed_completion",
      "change": "persisted_public_content_revision",
      "expected": "succeeded"
    }
  ]
}

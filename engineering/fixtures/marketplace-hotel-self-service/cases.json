{
  "contractVersion": "marketplace-hotel-self-service.v1",
  "cases": [
    {
      "caseId": "profile-status-complete-with-offer",
      "request": {
        "method": "GET",
        "path": "/api/marketplace/hotels/me/profile-status",
        "authRef": "hotelProfileOwner"
      },
      "fixtureNotes": "Seed a complete marketplace hotel profile and one non-archived marketplace offer for the same property and organization.",
      "expected": {
        "status": 200,
        "profile_complete": true,
        "missing_offers": false
      }
    },
    {
      "caseId": "profile-status-requires-offer",
      "request": {
        "method": "GET",
        "path": "/api/marketplace/hotels/me/profile-status",
        "authRef": "hotelProfileOwner"
      },
      "fixtureNotes": "Seed a complete marketplace hotel profile with no active offer.",
      "expected": {
        "status": 200,
        "profile_complete": false,
        "missing_offers": true,
        "completionStep": "Add at least one collaboration offer"
      }
    },
    {
      "caseId": "profile-status-denies-missing-profile-link",
      "request": {
        "method": "GET",
        "path": "/api/marketplace/hotels/me/profile-status",
        "authRef": "hotelWithoutProfileLink"
      },
      "expected": {
        "status": 403,
        "errorCode": "missing_hotel_profile_resource_link"
      }
    }
  ]
